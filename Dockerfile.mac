# Apple GPU inference runs in Docker Model Runner on the macOS host.
# This Ubuntu container provides the authenticated API on port 8000.
FROM ubuntu:24.04
RUN apt-get -o Acquire::http::Timeout=30 -o Acquire::Retries=2 update \
    && apt-get -o Acquire::http::Timeout=30 -o Acquire::Retries=2 install -y --no-install-recommends python3 ca-certificates \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY mac_gateway.py /app/mac_gateway.py
EXPOSE 8000
ENTRYPOINT ["python3", "-u", "/app/mac_gateway.py"]
